{
  "compilerOptions": {
    "outDir": "./dist/",
    "rootDir": "./src",
    "noImplicitAny": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2019",
    "noUnusedLocals": false,
    "lib": [
      "dom",
      "ESNext"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "declaration": true,
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
  ]
}
